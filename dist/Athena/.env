# Athena environment example
# Copy to .env and adjust. Never commit .env.

ATHENA_NAME=Athena
ATHENA_VERSION=0.1.0

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=nomic-embed-text

RAG_ENDPOINT=
OPENCLAW_ENDPOINT=http://127.0.0.1:18789
OPENCLAW_ENABLED=true
OPENCLAW_GATEWAY_TOKEN=2adade9128dffc4cf9317a2e8cea7f171f5c217a57516c68

WAKE_WORD=hey athena
TTS_ENABLED=true
STT_ENABLED=true

IDLE_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

CONFIRMATION_POLICY=confirm_medium_high
AUTO_EXECUTE_LOW_RISK=true
CONFIRM_MEDIUM_RISK=false
CONFIRM_HIGH_RISK=true
