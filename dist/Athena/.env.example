# Athena environment example
# Copy to .env and adjust. Never commit .env.

ATHENA_NAME=Athena
ATHENA_VERSION=0.1.0

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
EMBEDDING_MODEL=nomic-embed-text

RAG_ENDPOINT=
OPENCLAW_ENDPOINT=http://127.0.0.1:18789
OPENCLAW_ENABLED=false
# Gateway bearer token (also accepted as OPENCLAW_GATEWAY_TOKEN)
OPENCLAW_GATEWAY_TOKEN=

# Data engineering endpoints (no secrets in git — put passwords in .env only)
CLICKHOUSE_HOST=http://127.0.0.1:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
AIRFLOW_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Email (optional). Never commit real passwords.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# IMAP inbox (optional). Often same username/password as SMTP.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=true

WAKE_WORD=hey athena
TTS_ENABLED=true
STT_ENABLED=true

IDLE_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

CONFIRMATION_POLICY=confirm_medium_high
AUTO_EXECUTE_LOW_RISK=true
CONFIRM_MEDIUM_RISK=false
CONFIRM_HIGH_RISK=true
